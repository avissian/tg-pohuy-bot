# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Белый список chat_id через запятую. Сообщения из остальных чатов
# отбрасываются ДО обращения к модели. Изменение = правка + docker compose up -d.
ALLOWED_CHAT_IDS=1751261

# OpenAI-compatible API модели
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Настройки диалога (опционально)
HISTORY_DEPTH=16
MAX_REPLY_CHARS=3800
REQUEST_TIMEOUT=120
